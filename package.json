{
  "name": "tiktok-video-downloader",
  "version": "1.0.0",
  "private": true,
  "description": "Real TikTok video downloader: resolves video metadata from TikTok, streams watermark-free MP4 with Range support, optional FFmpeg conversion. Deployable on Render.com.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/",
    "check": "node --check src/server.js"
  },
  "keywords": [
    "tiktok",
    "downloader",
    "express",
    "render",
    "ffmpeg"
  ],
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "undici": "^6.21.0"
  }
}
