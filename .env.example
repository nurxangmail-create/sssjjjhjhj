# ---------------------------------------------------------------------------
# TikTok Video Downloader — environment configuration
# Copy to .env for local development. On Render.com set these in
# Dashboard -> your Web Service -> Environment.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=3000

# REQUIRED for multi-instance / restart stability.
# Signs download + thumbnail proxy tokens (HMAC-SHA256).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If missing, a random secret is generated per process (downloads break after restart).
TOKEN_SECRET=

# --- Providers -------------------------------------------------------------
# 1) Direct TikTok web JSON (primary, no API key needed)
ENABLE_TIKTOK_WEB=true

# 2) tikwm.com public API (fallback, no key, ~1 req/sec)
ENABLE_TIKWM=true
TIKWM_BASE=https://www.tikwm.com/api/

# 3) RapidAPI commercial tier (optional, needs a key + subscription)
#    Works with any TikTok scraper on RapidAPI that returns the tikwm-style
#    `{ code: 0, data: {...} }` envelope.
RAPIDAPI_KEY=
RAPIDAPI_HOST=tiktok-scraper7.p.rapidapi.com
RAPIDAPI_PATH=/

# 4) TikTok official oEmbed (metadata / existence check only)
ENABLE_OEMBED=true

# --- Network hardening -----------------------------------------------------
HTTP_TIMEOUT_MS=12000
HTTP_RETRIES=2
# Optional HTTP(S) proxy used ONLY for tiktok.com requests when Render's
# datacenter IPs get rate-limited or blocked. Example: http://user:pass@host:port
TIKTOK_PROXY=

# --- Caching ---------------------------------------------------------------
CACHE_TTL_SECONDS=480

# --- FFmpeg (conversion / MP3 / compatibility transcode) -------------------
# Render native Node runtimes ship WITHOUT ffmpeg. Use the included Dockerfile
# (render.yaml default) to get it, or set these to a static build path.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_CONCURRENT_JOBS=2
JOB_TTL_SECONDS=1200
JOB_TIMEOUT_SECONDS=300
MAX_INPUT_MB=400

# --- Rate limits (per IP / minute) ----------------------------------------
RL_RESOLVE_PER_MIN=30
RL_JOB_PER_MIN=10

# Photo-post gallery cap
MAX_PHOTOS=40
